{
  "manifest_version": 3,
  "name": "Plugwarden",
  "short_name": "Plugwarden",
  "description": "A small, fast password manager client for self-hosted Vaultwarden servers.",
  "version": "0.1.0",
  "default_locale": "en",
  "minimum_chrome_version": "156",
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Plugwarden" },
  "permissions": ["storage", "alarms", "idle", "offscreen"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "incognito": "not_allowed"
}
