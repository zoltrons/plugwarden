{
  "manifest_version": 3,
  "name": "Plugwarden",
  "short_name": "Plugwarden",
  "description": "A small, fast password manager client for self-hosted Vaultwarden servers.",
  "version": "0.2.2",
  "default_locale": "en",
  "minimum_chrome_version": "156",
  "update_url": "https://github.com/zoltrons/plugwarden/releases/latest/download/updates.xml",
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Plugwarden" },
  "permissions": ["storage", "alarms", "idle", "offscreen", "clipboardWrite", "scripting", "contextMenus", "sidePanel"],
  "side_panel": { "default_path": "sidepanel.html" },
  "host_permissions": ["https://*/*", "http://*/*"],
  "optional_permissions": ["privacy"],
  "content_scripts": [
    { "matches": ["https://*/*", "http://*/*"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle" }
  ],
  "web_accessible_resources": [
    {
      "resources": ["menu.html", "bar.html"],
      "matches": ["https://*/*", "http://*/*"],
      "use_dynamic_url": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "commands": {
    "autofill-login": {
      "suggested_key": { "default": "Ctrl+Shift+L", "mac": "Command+Shift+L" },
      "description": "__MSG_cmdAutofill__"
    }
  },
  "incognito": "not_allowed"
}
