{
  "name": "plugwarden",
  "version": "0.2.2",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "build:wasm": "bash tools/build-wasm.sh --simd",
    "build": "node tools/build.mjs",
    "watch": "node tools/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
    "test:e2e": "node --experimental-strip-types tests/e2e/run.ts",
    "test:passkeys": "node tools/smoke-passkeys.mjs",
    "size": "node tools/size-report.mjs --check dist/wasm/core_wasm_bg.wasm dist/wasm/core_wasm.js dist/ext/background.js dist/ext/offscreen.js dist/ext/worker.js dist/ext/popup.js dist/ext/popup.css dist/ext/passkey-page.js dist/ext/passkey-relay.js dist/ext/sso-callback.js",
    "sync-upstream": "node tools/sync-upstream.mjs",
    "test:biometric": "node tools/build.mjs --e2e && node tools/smoke-biometric.mjs"
  },
  "devDependencies": {
    "@types/chrome": "0.3.5",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2"
  }
}
